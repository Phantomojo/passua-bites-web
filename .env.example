# Frontend build-time configuration (safe to expose in the browser)
VITE_API_URL=https://passua-api.onrender.com/api/trpc

# Server-only configuration; never place these in VITE_* variables.
DATABASE_URL=
JWT_SECRET=
ADMIN_PASSWORD=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_CALLBACK_URL=https://your-api-domain.example/api/mpesa/callback

# Customer-facing payment channel. Pochi receipt verification is manual until Safaricom provisions a supported API for this account.
PAYMENT_MODE=pochi
POCHI_BUSINESS_NUMBER=0725619991

# Optional server settings
NODE_ENV=production
PORT=3000


# WhatsApp Business Platform Cloud API (server-only; never expose as VITE_* variables)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_API_VERSION=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_ORDER_RECEIVED_TEMPLATE=passua_order_received
WHATSAPP_ORDER_STATUS_TEMPLATE=passua_order_status
